<%- include('../../partials/cabecalhoAdmin') %>

<div class="cabecalho-admin">
  <h1>Solicitações de adoção</h1>
</div>

<form class="filtros-linha" method="get" action="/admin/solicitacoes">
  <div class="campo">
    <label for="protocolo">Protocolo</label>
    <input type="search" id="protocolo" name="protocolo" value="<%= filtros.protocolo %>" placeholder="2026-000148">
  </div>
  <div class="campo">
    <label for="status">Situação</label>
    <select id="status" name="status">
      <option value="">Todas</option>
      <% statusPossiveis.forEach(function (s) { %>
        <option value="<%= s.valor %>" <%= filtros.status === s.valor ? 'selected' : '' %>><%= s.rotulo %></option>
      <% }); %>
    </select>
  </div>
  <div class="campo">
    <label for="animal">Animal</label>
    <select id="animal" name="animal">
      <option value="">Todos</option>
      <% animais.forEach(function (a) { %>
        <option value="<%= a.id_animal %>" <%= String(filtros.animal) === String(a.id_animal) ? 'selected' : '' %>><%= a.nome %></option>
      <% }); %>
    </select>
  </div>
  <div class="campo">
    <label for="cidade">Cidade</label>
    <input type="search" id="cidade" name="cidade" value="<%= filtros.cidade %>">
  </div>
  <div class="campo">
    <label for="de">De</label>
    <input type="date" id="de" name="de" value="<%= filtros.de %>">
  </div>
  <div class="campo">
    <label for="ate">Até</label>
    <input type="date" id="ate" name="ate" value="<%= filtros.ate %>">
  </div>
  <div class="campo campo--acao">
    <button class="botao" type="submit">Filtrar</button>
    <a class="botao botao--contorno" href="/admin/solicitacoes">Limpar</a>
  </div>
</form>

<p class="contador"><%= f.pluralizar(resultado.total, 'pedido encontrado', 'pedidos encontrados') %></p>

<% if (resultado.itens.length) { %>
<div class="tabela-rolagem">
  <table class="tabela">
    <caption class="rotulo-oculto">Pedidos de adoção recebidos</caption>
    <thead>
      <tr>
        <th scope="col">Protocolo</th>
        <th scope="col">Animal</th>
        <th scope="col">Interessado</th>
        <th scope="col">Cidade</th>
        <th scope="col">Recebido em</th>
        <th scope="col">Situação</th>
      </tr>
    </thead>
    <tbody>
      <% resultado.itens.forEach(function (s) { %>
        <tr>
          <th scope="row"><a href="/admin/solicitacoes/<%= s.id_solicitacao %>"><%= s.protocolo %></a></th>
          <td><%= s.animal ? s.animal.nome : '—' %></td>
          <td><%= s.nome_interessado %></td>
          <td><%= s.cidade %>/<%= s.uf %></td>
          <td><%= f.dataHora(s.data_solicitacao) %></td>
          <td><span class="<%= 'selo selo--' + s.status.toLowerCase() %>"><%= f.statusPedido(s.status) %></span></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<% const queryBase = Object.entries(filtros).filter(([, v]) => v).map(([k, v]) => k + '=' + encodeURIComponent(v)).join('&'); %>
<%- include('../../partials/paginacao', { resultado: resultado, queryBase: queryBase }) %>
<% } else { %>
  <div class="vazio">
    <h2>Nenhum pedido com esses filtros</h2>
    <p>Ajuste o período ou a situação para ver outros pedidos.</p>
  </div>
<% } %>

<%- include('../../partials/rodapeAdmin') %>

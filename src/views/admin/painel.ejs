<%- include('../partials/cabecalhoAdmin') %>

<div class="cabecalho-admin">
  <h1>Painel</h1>
  <p>Números da operação neste momento.</p>
</div>

<section class="numeros">
  <div class="numero">
    <span class="numero__valor"><%= resumo.totalAnimais %></span>
    <span class="numero__rotulo">animais ativos no cadastro</span>
  </div>
  <div class="numero">
    <span class="numero__valor"><%= resumo.aguardando %></span>
    <span class="numero__rotulo">pedidos aguardando decisão</span>
  </div>
  <div class="numero">
    <span class="numero__valor"><%= resumo.adocoesConcluidas %></span>
    <span class="numero__rotulo">adoções concluídas</span>
  </div>
  <div class="numero">
    <span class="numero__valor"><%= resumo.totalSolicitacoes %></span>
    <span class="numero__rotulo">pedidos recebidos no total</span>
  </div>
</section>

<div class="colunas-duas">
  <section class="bloco">
    <h2>Animais por situação</h2>
    <table class="tabela">
      <caption class="rotulo-oculto">Quantidade de animais em cada situação</caption>
      <thead><tr><th scope="col">Situação</th><th scope="col">Animais</th></tr></thead>
      <tbody>
        <% resumo.animais.forEach(function (item) { %>
          <tr>
            <th scope="row"><span class="<%= f.classeSituacao(item.chave) %>"><%= item.rotulo %></span></th>
            <td><%= item.total %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </section>

  <section class="bloco">
    <h2>Pedidos por situação</h2>
    <table class="tabela">
      <caption class="rotulo-oculto">Quantidade de pedidos em cada situação</caption>
      <thead><tr><th scope="col">Situação</th><th scope="col">Pedidos</th></tr></thead>
      <tbody>
        <% resumo.solicitacoes.forEach(function (item) { %>
          <tr>
            <th scope="row"><span class="<%= 'selo selo--' + item.chave.toLowerCase() %>"><%= item.rotulo %></span></th>
            <td><%= item.total %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </section>
</div>

<section class="bloco">
  <h2>Pedidos mais recentes</h2>
  <% if (resumo.recentes.length) { %>
    <table class="tabela">
      <caption class="rotulo-oculto">Últimos pedidos recebidos</caption>
      <thead>
        <tr><th scope="col">Protocolo</th><th scope="col">Animal</th><th scope="col">Interessado</th><th scope="col">Recebido em</th><th scope="col">Situação</th></tr>
      </thead>
      <tbody>
        <% resumo.recentes.forEach(function (s) { %>
          <tr>
            <th scope="row"><a href="/admin/solicitacoes/<%= s.id_solicitacao %>"><%= s.protocolo %></a></th>
            <td><%= s.animal ? s.animal.nome : '—' %></td>
            <td><%= s.nome_interessado %></td>
            <td><%= f.dataHora(s.data_solicitacao) %></td>
            <td><span class="<%= 'selo selo--' + s.status.toLowerCase() %>"><%= f.statusPedido(s.status) %></span></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } else { %>
    <p class="vazio vazio--curto">Nenhum pedido recebido ainda.</p>
  <% } %>
</section>

<%- include('../partials/rodapeAdmin') %>

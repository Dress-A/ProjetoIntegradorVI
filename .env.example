# ---- Aplicacao ----
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=troque-esta-chave-em-producao

# ---- Banco de dados (PostgreSQL 16) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=adotapel
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=false

# ---- Usuarios de demonstracao criados pelo npm run db:setup ----
SEED_ADMIN_EMAIL=admin@adotapel.org.br
SEED_ADMIN_SENHA=Admin@2026
SEED_VOLUNTARIO_EMAIL=voluntario@adotapel.org.br
SEED_VOLUNTARIO_SENHA=Voluntario@2026

# ---- Upload de fotos ----
UPLOAD_DIR=src/public/uploads
UPLOAD_MAX_BYTES=2097152

# ---- Envio de e-mail (RF15). Sem SMTP configurado, o e-mail e gravado em logs/emails ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="AdotaPel <nao-responda@adotapel.org.br>"
